# Metabase internal DB (separate from Phoenix Supabase — Metabase stores its own config)
METABASE_DB_HOST=db.your-staging-supabase-ref.supabase.co
METABASE_DB_PORT=5432
METABASE_DB_NAME=postgres
METABASE_DB_USER=analytics_readonly
METABASE_DB_PASS=REPLACE_WITH_ANALYTICS_READONLY_PASSWORD

# Metabase embedding (generate a random 32-char secret)
METABASE_EMBEDDING_SECRET_KEY=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# Phoenix env var (for server-side embed URL signing)
METABASE_EMBED_SECRET=REPLACE_WITH_SAME_SECRET_AS_ABOVE
METABASE_SITE_URL=http://localhost:3030
