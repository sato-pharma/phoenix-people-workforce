{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // Speeds up warm/incremental re-checks on this single large project by skipping
    // deep re-analysis of files that only changed indirectly. Audited 2026-07-03:
    // does not affect cold-run time (CI is always cold), only local warm re-typechecks.
    "assumeChangesOnlyAffectDirectDependencies": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*", "./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "infra/phoenix-mcp",
    ".railway", "node_modules",
    ".next",
    "phoenix-architecture",
    "phoenix-system-export",
    ".claude",
    // ".codex-worktrees" and "_wt-*" hold full checkouts of other branches used for
    // parallel sessions (see AGENTS.md "Session And Worktree Safety"). Without these,
    // tsc walks every duplicate copy too — confirmed ~12x the file count and ~9x the
    // typecheck time locally. Do not remove without confirming no in-repo worktree
    // naming pattern is left unmatched.
    ".codex-worktrees",
    "_wt-*",
    // The native Android app (Expo / React Native). It is a separate program with its own
    // tsconfig, its own React types and its own module resolution — `react-native`'s JSX and
    // DOM-free lib set are incompatible with the "dom" lib this project compiles against, so
    // tsc walking it produces hundreds of errors for code that is correct. Check it with
    // `npm run typecheck` inside mobile/, which is what CI's mobile job runs.
    "mobile",
    "scripts/tmp",
    "supabase/.temp",
    // Deno code for Supabase Edge Functions (`npm:` imports, the `Deno` global) — not this program
    // (supabase/functions/README.md).
    "supabase/functions",
    // Gitignored scratch space (.gitignore: "outputs/"). Files rescued out of
    // orphan worktrees land here with their original relative imports, which no
    // longer resolve from this depth — so tsc failed on a file that is not in
    // the repo, blocking typecheck and the pre-push hook for everyone. Same
    // reasoning as the worktree entries above: if git ignores it, tsc should not
    // be walking it.
    "outputs",
    // Same story as "outputs", hit on 2026-08-13: audit scratch space holding COPIES of this
    // repo's own app/, src/ and tests/ trees (artifacts/marketing-requests-audit is 235 files /
    // 4.4 MB). tsc walked them and failed with TS7006 on
    // artifacts/.../tests/sales-marketing-line-scope.test.ts — a file that is not part of the
    // build — which blocked the pre-push hook for every push from this checkout.
    "artifacts"
  ]
}
