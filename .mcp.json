{
  "mcpServers": {
    "supabase-staging": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=cifwmndunmlxjhyjugxa",
      "headers": {
        "Authorization": "Bearer ${SUPABASE_PROD_TOKEN}"
      }
    },
    "supabase-production": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp",
      "headers": {
        "Authorization": "Bearer ${SUPABASE_PROD_TOKEN}"
      }
    },
    "mailbox": {
      "type": "stdio",
      "command": "node",
      "args": [
        "--env-file-if-exists=.env.local",
        "scripts/mailbox-mcp.mjs"
      ]
    }
  }
}
