{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Read|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Grep|Glob|mcp__supabase.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-dispatch.mjs",
              "PreToolUse"
            ],
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/test-registration-check.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/autorun-guard.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/module-memory-injector.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-lock.mjs",
              "start"
            ]
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/sync-worktree-env.mjs",
              "--hook"
            ],
            "statusMessage": "Provisioning node_modules + env in this worktree"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/sync-worktree-env.mjs",
              "--sweep-only"
            ],
            "async": true,
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/memory-index-guard.mjs"
            ],
            "statusMessage": "Checking memory index budget"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/cloud-mirror-drift-refresh.mjs"
            ],
            "async": true,
            "timeout": 120
          },
          {
            "type": "command",
            "command": "DIR=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; if [ \"${CLAUDE_CODE_REMOTE:-}\" = \"true\" ] && [ -f \"$DIR/.claude/hooks/session-start-remote.sh\" ]; then bash \"$DIR/.claude/hooks/session-start-remote.sh\" || true; fi",
            "shell": "bash",
            "timeout": 1200,
            "statusMessage": "Preparing the cloud session (Node, pnpm, dependencies)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-lock.mjs",
              "end"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-exit-guard.mjs"
            ],
            "timeout": 45,
            "statusMessage": "Checking worktree state"
          }
        ]
      }
    ]
  },
