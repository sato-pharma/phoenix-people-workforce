{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$DIR/.claude/hooks/bash-guard.mjs\" 2>/dev/null || true",
            "shell": "bash"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DIR=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$DIR/.claude/hooks/session-lock.mjs\" start \"$DIR\" 2>/dev/null || true",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "DIR=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; if [ -f \"$DIR/.git\" ] && [ -f \"$DIR/scripts/sync-worktree-env.mjs\" ]; then node \"$DIR/scripts/sync-worktree-env.mjs\" 2>/dev/null || true; fi",
            "shell": "bash",
            "statusMessage": "Syncing worktree env"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DIR=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$DIR/.claude/hooks/session-lock.mjs\" end \"$DIR\" 2>/dev/null || true",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "DIR=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$DIR/.claude/hooks/worktree-exit-guard.mjs\" \"$DIR\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 45,
            "statusMessage": "Checking worktree state"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm run worktree:sync-env)",
      "Bash(git fetch *)",
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list*)",
      "Bash(gh run watch *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gcloud run services describe *)",
      "Bash(gcloud run revisions list *)",
      "Bash(gcloud run revisions describe *)",
      "Bash(gcloud logging read *)",
      "Bash(gcloud scheduler jobs describe *)",
      "Bash(gcloud scheduler jobs list *)",
      "Bash(gcloud compute ssl-certificates describe *)",
      "Bash(tasklist *)",
      "Bash(wait)",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__preview_start",
      "mcp__Claude_Browser__preview_stop",
      "mcp__Claude_Browser__preview_list",
      "mcp__Claude_Browser__preview_logs",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__tabs_context",
      "mcp__Claude_Browser__tabs_create",
      "mcp__Claude_Browser__resize_window",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__list_connected_browsers",
      "mcp__ccd_session__mark_chapter",
      "mcp__supabase-staging",
      "mcp__supabase-production",
      "Bash(supabase:*)",
      "Bash(npx supabase:*)",
      "Bash(pnpm supabase:*)",
      "Bash(pnpm dlx supabase:*)",
      "PowerShell(supabase *)",
      "PowerShell(npx supabase *)",
      "PowerShell(pnpm supabase *)",
      "PowerShell(pnpm dlx supabase *)",
      "Read(./.env*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(Get-Content *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Select-String *.env*)"
    ],
    "ask": [],
    "deny": [
      "mcp__b345e47e-3198-4b48-97cc-07b47bbb3087__*"
    ]
  }
}
