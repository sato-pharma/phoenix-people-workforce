{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bash-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Grep|Glob|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/trap-injector.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-lock.mjs\" beat",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/primary-write-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/mobile-freeze-guard.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/autorun-guard.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-lock.mjs\" start"
          },
          {
            "type": "command",
            "command": "DIR=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; if [ -f \"$DIR/scripts/sync-worktree-env.mjs\" ]; then node \"$DIR/scripts/sync-worktree-env.mjs\" --all 2>/dev/null || true; fi",
            "shell": "bash",
            "statusMessage": "Provisioning node_modules + env in all worktrees"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/memory-index-guard.mjs\"",
            "statusMessage": "Checking memory index budget"
          },
          {
            "type": "command",
            "command": "DIR=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; if [ \"${CLAUDE_CODE_REMOTE:-}\" = \"true\" ] && [ -f \"$DIR/.claude/hooks/session-start-remote.sh\" ]; then bash \"$DIR/.claude/hooks/session-start-remote.sh\" || true; fi",
            "shell": "bash",
            "timeout": 1200,
            "statusMessage": "Preparing the cloud session (Node, pnpm, dependencies)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-lock.mjs\" end"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-exit-guard.mjs\"",
            "timeout": 45,
            "statusMessage": "Checking worktree state"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list*)",
      "Bash(gh run watch *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(tasklist *)",
      "Bash(wait)",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__preview_start",
      "mcp__Claude_Browser__preview_stop",
      "mcp__Claude_Browser__preview_list",
      "mcp__Claude_Browser__preview_logs",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__tabs_context",
      "mcp__Claude_Browser__tabs_create",
      "mcp__Claude_Browser__resize_window",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__list_connected_browsers",
      "mcp__ccd_session__mark_chapter",
      "mcp__supabase-staging",
      "mcp__supabase-production",
      "Bash(supabase:*)",
      "Bash(npx supabase:*)",
      "Bash(pnpm supabase:*)",
      "Bash(pnpm dlx supabase:*)",
      "PowerShell(supabase *)",
      "PowerShell(npx supabase *)",
      "PowerShell(pnpm supabase *)",
      "PowerShell(pnpm dlx supabase *)",
      "Read(./.env*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Select-String *.env*)"
    ],
    "ask": [],
    "deny": [
      "mcp__b345e47e-3198-4b48-97cc-07b47bbb3087",
      "mcp__45bb6356-8105-4482-9464-25bfd754baec",
      "Bash(gh pr merge *--auto*)",
      "PowerShell(gh pr merge *--auto*)",
      "Bash(gh api *enablePullRequestAutoMerge*)",
      "PowerShell(gh api *enablePullRequestAutoMerge*)",
      "Bash(railway service source connect*)",
      "PowerShell(railway service source connect*)"
    ]
  }
}
