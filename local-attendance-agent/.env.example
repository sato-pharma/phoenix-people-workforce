PHOENIX_BASE_URL=http://localhost:3000
ATTENDANCE_AGENT_TOKEN=replace-with-the-same-token-used-by-phoenix
# Optional, and a DIFFERENT value from the line above - the agent refuses to start if they match.
# Phoenix hands this one to the browser so the admin page's "Sync Now" button can call this agent
# directly; it unlocks /sync-now and nothing else. ATTENDANCE_AGENT_TOKEN must never go to a
# browser, because it is also what authenticates attendance writes into Phoenix.
# ATTENDANCE_AGENT_BROWSER_TOKEN=replace-with-a-second-separate-token
DEVICE_ID=zkteco-main
DEVICE_IP=192.168.100.52
DEVICE_PORT=4370
DEVICE_COMM_PASSWORD=02026
DEVICE_READ_METHOD=ssr
SYNC_START_DATE=2026-01-01
DEVICE_OPERATION_TIMEOUT_SECONDS=420
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MINUTES=120
AUTO_SYNC_REQUIRED_TIMES=17:00

# Optional. Defaults to http://127.0.0.1:8787
# ASPNETCORE_URLS=http://127.0.0.1:8787
