# ============================================================
# Phoenix Workforce — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.
# ============================================================


# ----- App URLs -----
# Base URL of the running application (used for password-setup links, offer URLs, etc.)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# A third alias for the same origin, read by the Telegram admin control centre and the
# marketing-assignment backfill cron to build absolute links. Keep it identical to APP_URL:
# scripts/refresh-local-env.mjs rewrites all three to localhost when it regenerates .env.local,
# precisely so a local run cannot post a production link into a real chat.
PHOENIX_APP_URL=http://localhost:3000

# URL shown in notification emails for the "View Dashboard" link
NOTIFICATION_DASHBOARD_URL=http://localhost:3000


# ----- Supabase (required) -----
# Project URL and keys from your Supabase dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The project's own reference — the first label of the URL above. Read by maintenance scripts
# rather than by the app. Both names hold the SAME project: the Railway sync treats each as the
# other's fallback, and different scripts happen to read different names.
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PROJECT_REF=your-project-ref

# The newer publishable key (Supabase's successor to the anon key above). Read by ZERO lines of
# code in this repository — verified 2026-09-30 across src/, app/ and scripts/ — so it is left
# commented out deliberately: setting it changes nothing, and requiring it once meant an emergency
# production secret sync could abort over a variable whose absence has no effect. Uncomment it the
# day something actually reads it.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres connection string (used by migration/validation scripts)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres


# ----- Auth & Session (required) -----
# Secret used to sign application session tokens (hex string, min 64 chars recommended)
PHOENIX_AUTH_SECRET=generate-a-random-64-char-hex-string

# TEMPORARY, until 2026-11-22 (src/lib/auth/previous-secret.ts): the PRE-rotation value of
# PHOENIX_AUTH_SECRET, so links people already hold (email-signature pictures, unsubscribe, offer
# acceptance, closing PDF, share cards) keep opening after the secret is replaced. Logins, password
# reset codes and payroll acknowledgment links NEVER accept it. Ignored after the end date; leave
# empty locally and delete the variable once that date has passed.
PHOENIX_AUTH_SECRET_PREVIOUS=


# ----- Email / Notifications -----
# Master switch: set to "true" to enable outbound email delivery
EMAIL_NOTIFICATIONS_ENABLED=false

# Testing safety switch: when "true" (default), ALL outgoing email is redirected
# to test recipients instead of real addresses. Set to "false" in production only.
PHOENIX_EMAIL_FORCE_TESTING=true

# Delivery mode: "live" sends real emails, "log" prints to console
PHOENIX_EMAIL_DELIVERY_MODE=log

# Comma-separated list of addresses that receive ALL emails in test mode
PHOENIX_EMAIL_TEST_RECIPIENTS=

# Resend API key (https://resend.com) — required when delivery mode is "live"
RESEND_API_KEY=

# Resend webhook signing secret (verifies inbound webhook payloads)
RESEND_WEBHOOK_SECRET=

# Failover chain when a quota runs out: Resend → Resend 2 → Resend 3 → Brevo → Brevo 2. Each extra
# account is optional and joins the chain only when its key is set.
RESEND_API_KEY_2=
RESEND_EMAIL_FROM_2=
RESEND_WEBHOOK_SECRET_2=
RESEND_API_KEY_3=
RESEND_EMAIL_FROM_3=
RESEND_WEBHOOK_SECRET_3=
# A module's DEDICATED Resend account (sales first, sending as sales@sales.satopharma.com). It carries
# only that module's mail, is tried first for it, and is inert until BOTH the key and the sender are set.
RESEND_API_KEY_SALES=
RESEND_EMAIL_FROM_SALES=
RESEND_WEBHOOK_SECRET_SALES=
# People (leave, excuses, attendance, probation, contracts, resignations, recruitment, birthdays),
# sending as people@people.satopharma.com.
RESEND_API_KEY_PEOPLE=
RESEND_EMAIL_FROM_PEOPLE=
RESEND_WEBHOOK_SECRET_PEOPLE=
BREVO_API_KEY=
BREVO_EMAIL_FROM=
BREVO_API_KEY_2=
BREVO_EMAIL_FROM_2=

# Default "From" address for notification emails. Use a RECOGNISABLE, REPLY-ABLE sender
# (not noreply@) on the Resend-verified sending domain, matching the in-code default
# identity. The From subdomain (send.satopharma.com) intentionally differs from the
# Reply-To apex (satopharma.com); both need their own SPF/DKIM in DNS.
NOTIFICATION_EMAIL_FROM=Phoenix Workforce <phoenix@send.satopharma.com>

# Default "Reply-To" address for notification emails
NOTIFICATION_REPLY_TO=phoenix@satopharma.com

# "From" address for job-offer emails. An offer speaks as Sato, never as Phoenix — a legally
# binding offer branded as somebody's internal HR software reads as phishing.
#
# TWO VALUES ARE ALLOWED AND NOTHING ELSE (owner rule, 2026-10-13): hr@satopharma.com or
# hr@send.satopharma.com, with or without a display name. Any other mailbox here is REFUSED in code
# (src/lib/email/job-offer-sender.ts) and the offer goes out from hr@satopharma.com instead, with
# the refused value shown on the Job Offers screen. Either spelling ends up on the apex on the
# wire, because that is where the mailbox is and a candidate reply must not bounce — and Resend's
# first account holds both satopharma.com and send.satopharma.com verified (measured 2026-10-13).
JOB_OFFER_EMAIL_FROM=Sato Pharma HR <hr@send.satopharma.com>

# Where a candidate's reply lands. The APEX domain, which is where the real mailboxes are (its MX
# points at Yahoo Business Mail). A candidate WILL reply to an offer, so every address here must be
# a real, monitored mailbox — a reply that bounces is worse than no offer at all. It may name MORE
# than one mailbox, comma-separated, and a reply then reaches all of them (the candidate's mail
# client fills every address into the To). Unset falls back to this same default in code.
JOB_OFFER_REPLY_TO=hr@satopharma.com, omar.anwar@satopharma.com

# "From" address for internal messaging emails (falls back to NOTIFICATION_EMAIL_FROM)
INTERNAL_MESSAGE_EMAIL_FROM=

# "From" address for HR admin email replies
HR_REPLY_EMAIL_FROM=

# Comma-separated HR emails that receive system-wide HR notifications
HR_NOTIFICATION_EMAILS=

# When true, notification emails include a "[TEST]" prefix in subject
NOTIFICATION_TEST_MODE=true

# Base URL for email template assets (logos, images)
HR_EMAIL_ASSET_BASE_URL=

# URL for the HR email signature block
HR_EMAIL_SIGNATURE_URL=


# ----- Telegram (optional — the admin control centre and the notification mirror) -----
# Bot token from @BotFather. 🔴 EVERY automated email in this system ALSO mirrors to the admin
# Telegram, so a REAL token sitting in a local file means a local run can page real people —
# leave it empty unless you are deliberately testing delivery, and never fire a digest or a bulk
# send from a laptop.
TELEGRAM_BOT_TOKEN=

# Shared secret behind the Telegram integration's INBOUND webhook. The token Telegram sends back
# is DERIVED from this value (telegramWebhookSecretToken(), src/lib/notifications/telegram.ts), so
# changing it invalidates the webhook Telegram already holds — re-register it afterwards with
# scripts/setup-telegram-bot.mjs. Unset disables only the inbound half; outbound sends still work.
NOTIFICATION_WEBHOOK_SECRET=


# ----- Anthropic (the second and third AI accounts) -----
# Every AI call tries OpenAI first, then ANTHROPIC_API_KEY, then ANTHROPIC_API_KEY_2, moving on only when
# the account asked is out of credit or refuses its key (src/lib/ai/). The Phoenix CRM signboard and
# timetable readers ask Claude first. Either key alone is enough for AI to count as configured.
# Server-only. Never expose these as NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_2=

# ----- OpenAI apps (optional - World Room and Launch Desk) -----
# Server-only OpenAI API key used by:
# - /api/world-room/realtime-session to mint one-minute Realtime client secrets.
# - /api/launch-desk/plan to run the Launch Desk Agents SDK workflow.
# Never expose this as NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Optional Launch Desk model override. Defaults to gpt-5.4-mini.
LAUNCH_DESK_MODEL=

# Launch Desk is enabled automatically in local development. Set true only when
# intentionally exposing it in preview/production.
LAUNCH_DESK_ENABLED=false

# Set true to disable Agents SDK trace export for local debugging.
LAUNCH_DESK_TRACING_DISABLED=false

# Optional stable, privacy-preserving safety identifier for Realtime sessions.
# Use a hashed internal user ID if World Room becomes authenticated.
OPENAI_REALTIME_SAFETY_IDENTIFIER=


# ----- Groq speech to text (optional — the Phoenix CRM spoken visit comment) -----
# Server-only. Turns a CRM visit voice note into Arabic text for a browser that has NO speech engine of
# its own — Firefox, on every platform. Chrome, Edge, Safari and Android use the browser's own free
# engine and never reach it, so only the Firefox share of visits is ever charged, and the recording cap
# is one minute. NOT OpenAI, deliberately: the owner's cost ruling of 2026-09-25.
#
# Unset is a supported state, not a broken one: the control asks the server whether this is configured
# and, where it is not, stops promising Firefox reps that their words will be written. Keys look like
# gsk_… and scripts/secret-shape-rules.mjs refuses a masked paste of one.
GROQ_API_KEY=


# ----- Google Maps (optional — outstation / field features) -----
# Server-side API key for Places Autocomplete and Place Details
GOOGLE_MAPS_SERVER_KEY=

# Browser-side API key for Maps JavaScript SDK (embedded maps)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Cloud-based Map ID for styled maps
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ----- LocationIQ (optional — first-choice geocoder for CRM check-ins + sales normalizer) -----
# Server-side key. Google (above) is still required as the accuracy fallback for low-confidence
# LocationIQ matches. Outstation, marketing-requests, and Routes/Directions always use Google
# directly and never read this key.
LOCATIONIQ_API_KEY=


# ----- Google Calendar (optional — national holidays) -----
# API key for Google Calendar API
GOOGLE_CALENDAR_API_KEY=

# Calendar ID for Egyptian public holidays (e.g. en.egyptian#holiday@group.v.calendar.google.com)
GOOGLE_HOLIDAY_CALENDAR_ID_EG=


# ----- Web Push / OneSignal (optional — desktop + mobile browser push notifications) -----
# Public app id from the OneSignal dashboard (Settings > Keys & IDs). Not a secret — the
# Web SDK ships it to every browser — so the same value is reused server-side to send.
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# ----- Sentry (sentry.io) — PRODUCTION ONLY, errors only (optional) -----
# Set both on the PRODUCTION Railway service and nowhere else; leave them empty locally and on staging.
# SENTRY_DSN is read at runtime and only when APP_ENV=production. NEXT_PUBLIC_SENTRY_DSN is baked into the
# browser bundle at build time (a Dockerfile ARG) and only used on the production host. Same DSN value.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only: an organisation token that may create releases and upload source maps. Leave empty locally;
# with it empty the build is exactly the plain one. Never put a value in this file.
SENTRY_AUTH_TOKEN=

# Server-only REST API key from the OneSignal dashboard (Settings > Keys & IDs). Used only
# to call the OneSignal Send Notification API — never expose this to the browser.
ONESIGNAL_REST_API_KEY=


# ----- Attendance Agent (optional — local ZKTeco integration) -----
# URL of the local .NET attendance agent
ATTENDANCE_AGENT_LOCAL_URL=http://127.0.0.1:8787

# Shared secret token for authenticating with the attendance agent
ATTENDANCE_AGENT_TOKEN=

# Path to the script that starts the attendance agent process
ATTENDANCE_AGENT_START_SCRIPT=

# Working directory for the attendance agent process
ATTENDANCE_AGENT_WORKING_DIRECTORY=

# Default ZKTeco device ID for user-device mapping
ATTENDANCE_DEFAULT_DEVICE_ID=1

# IANA time zone for attendance report timestamps
ATTENDANCE_REPORT_TIME_ZONE=Africa/Cairo


# ----- iReports360 CRM (required in production — the rep visit and plan mirror) -----
# The vendor Reporting API that every CRM figure in Phoenix is mirrored from. src/lib/crm/config.ts
# reads all three and throws by NAME when one is missing, while the sync panel greys itself out
# rather than failing when they are absent, so an unset trio looks like a switched-off feature and
# a WRONG one looks like a rep who did nothing — the vendor answers an empty grid, not an error.
# The base URL is per TENANT (a numbered site host), so it is not guessable: read it off Railway.
IREPORTS360_BASE_URL=
IREPORTS360_USERNAME=
IREPORTS360_PASSWORD=

# 🔴 THE LIVE POLLER'S SWITCH — LEAVE THIS COMMENTED OUT. Set to exactly "true" it starts the
# in-process poller that WRITES the CRM mirror, and a dev machine's .env.local points at
# PRODUCTION Supabase, so a local copy would run a second writer against production's own data.
# Two further guards would still refuse it here (a production build, and
# RAILWAY_ENVIRONMENT_NAME=production), but src/lib/crm/live-poller.ts states as an invariant that
# this flag is in no .env file in this repo, and that is the first line of defence. Railway holds
# it; nothing local should, which is also why scripts/refresh-local-env.mjs refuses to copy it.
# PHOENIX_LIVE_CRM_POLL=true


# ----- Action1 (optional) -----
# Lets the Device Custody register pull the fleet from Action1 instead of anybody typing a serial.
# Create the key in Action1 under Configuration -> Users & API Credentials.
# Unset is a supported state: the button answers with these variable names instead of failing.
# The secret is a fleet-wide read credential — server-only, never exposed to a browser.
ACTION1_CLIENT_ID=
ACTION1_CLIENT_SECRET=

# Tenant API root. EU tenants are https://app.eu.action1.com/api/3.0
ACTION1_API_BASE_URL=https://app.action1.com/api/3.0

# Only needed when the Action1 account holds more than one organization. With several and none set,
# the pull refuses and names them rather than registering the wrong company's machines.
ACTION1_ORG_ID=


# ----- Headwind MDM + RustDesk (optional — the company's own rep-tablet server) -----
# Lets Rep Tablets drive the fleet from the company's OWN device-management server (Headwind, on
# Railway), and open a free remote-screen session on a tablet through RustDesk. Full account, and how
# the server is built: docs/devices/headwind-rustdesk.md
#
# UNSET IS THE SHIPPED STATE. With HEADWIND_MDM_* unset the Headwind card does not render and no
# route reaches out — /devices/tablets is byte-for-byte the page it is today. Setting these three is
# what turns it on.
#
# 🔴 THE BOX MUST RUN THE PHOENIX-BUILT IMAGE, and no variable here can say so. Lock, lost mode,
# factory reset and reset-the-screen-lock are carried by our own SyncResponseHook add-on, baked into
# the image by infra/headwind-phoenix-actions/Dockerfile. On the stock headwind/hmdm image those four
# answer a refusal that reads like a broken tablet. Everything else works on either image.
#
# The address has no safe default: a guessed one would send an admin password to whoever owns that
# name. Give Phoenix its OWN admin account on the server, not a person's.
HEADWIND_MDM_BASE_URL=
HEADWIND_MDM_LOGIN=

# The password in PLAIN TEXT here. Phoenix MD5-hashes it before sending because that is Headwind's
# wire format — do not pre-hash it, and never "upgrade" the hash: the server would refuse every
# sign-in. A Headwind admin password factory-resets tablets: server-only, never logged.
HEADWIND_MDM_PASSWORD=

# The Cloudflare Access SERVICE TOKEN, because the console sits behind a Cloudflare Tunnel (owner,
# 2026-09-25 — Headwind Community has no admin two-factor). Access asks a PERSON to sign in and
# Phoenix is not one: without these, every Phoenix call is answered by Cloudflare's sign-in page
# instead of by Headwind. Both or neither — one alone is refused by name, since a half token would
# otherwise surface as an unreadable reply from a server that is perfectly healthy. Unset on a
# server with no tunnel. Sent as CF-Access-Client-Id / CF-Access-Client-Secret; never logged.
HEADWIND_MDM_ACCESS_CLIENT_ID=
HEADWIND_MDM_ACCESS_CLIENT_SECRET=

# 🔴 LEAVE BOTH EMPTY — EMPTY IS THE WORKING SETTING, NOT A MISSING ONE. Empty means RustDesk's own
# free EU relay, which is what this fleet uses since 2026-09-25 (owner's decision), and screen view
# and control work with no server of any kind. RustDesk is NaCl end-to-end encrypted, so a relay —
# anyone's relay — carries ciphertext it cannot read; self-hosting buys custody and an SLA, not
# secrecy.
#
# Fill them in ONLY if the company later runs its own relay from docker-compose.headwind.yml: the
# `hbbs` host, and its PUBLIC key from rustdesk-data/id_ed25519.pub on that box. The public key is
# public by design — every client needs it to verify the relay — and the private key never leaves
# the server.
#
# 🔴 BOTH OR NEITHER. One alone is refused by name and turns the screen buttons off, because a
# client pointed at a private relay it cannot verify does not fail loudly — it quietly connects
# somewhere else, and a fleet everyone believes is on the company's own relay while it is not is
# worse than either honest answer.
RUSTDESK_RELAY_HOST=
RUSTDESK_PUBLIC_KEY=

# The Android package the remote-screen app installs under. Only set this if a rebuilt client
# changes the package.
RUSTDESK_APP_PACKAGE=com.carriez.flutter_hbb

# 🔴 THE SCREEN-SESSION PASSWORD IS NOT HERE AND MUST NEVER BE. Phoenix builds a connect target and
# stops; the person types the tablet's access password into the RustDesk app themselves. RustDesk's
# link scheme accepts one in the query string, and a URL is logged by browsers, proxies and anything
# that touches it.
#
# The SERVER's own settings (ADMIN_EMAIL, BASE_DOMAIN, SQL_*, the pinned image tags) are a different
# file: .env.headwind ON THE BOX, beside docker-compose.headwind.yml. None of it goes on Railway.


# ----- Cron / Scheduling (Cloud Run + Cloud Scheduler) -----
# CRON_SECRET authenticates Cloud Scheduler requests to /api/notifications/* and
# /api/cron/*. Each scheduler job must send: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# TEMPORARY, until 2026-11-22 (src/lib/auth/previous-secret.ts): the PRE-rotation CRON_SECRET, also
# accepted as a cron bearer so the scheduler's jobs can be moved to the new value one at a time.
# Never accepted by a route on its own token. Ignored after the end date; leave empty locally.
CRON_SECRET_PREVIOUS=

# FTP_VIDEO_HANDOFF_SECRET authenticates the Future Talents Portal's calls to
# /api/integrations/ftp-videos (list and claim WhatsApp closing videos). Its own token, never
# CRON_SECRET. The portal holds the same value as PHOENIX_VIDEO_RELAY_SECRET.
FTP_VIDEO_HANDOFF_SECRET=

# APP_ENV marks the runtime as production on Cloud Run (Vercel's VERCEL_ENV is not
# set there). Leave unset locally; set APP_ENV=production on the Cloud Run service.
# APP_ENV=production


# ----- Dead-man's-switch monitoring (optional — external liveness alert for the 7
# Cloud Scheduler jobs, independent of Sentry/GCP; see docs/observability.md) -----
# Healthchecks.io project Ping Key (Project Settings, next to the API keys). Inert until set —
# no ping is ever attempted without it, in any environment.
HEALTHCHECKS_PING_KEY=

# Override only for a self-hosted Healthchecks instance. Leave unset to use hc-ping.com.
HEALTHCHECKS_PING_HOST=


# ----- Recruitment: the public careers apply form (optional) -----
# POST /api/public/apply is the one endpoint here that anybody on the internet may call, so it has
# no session and no shared secret to lean on: a reCAPTCHA token plus a per-IP rate limit is the
# whole anti-abuse story.
#
# 🔴 UNSET MEANS THE BOT CHECK IS SKIPPED, NOT ENFORCED. That is deliberate — the form works the
# day it ships and hardens when the key is added, with the rate limit guarding it meanwhile — but
# it is also how production ran with no bot check at all and nothing said so. Since 2026-09-30 the
# skip is LOGGED once per process (event=recaptcha_secret_unset) instead of passing in silence.
# The key itself is minted at Google by the owner: never invent one.
RECRUITMENT_APPLY_RECAPTCHA_SECRET=

# Comma-separated origins allowed to call the apply endpoints cross-site. Unset falls back to the
# two real careers hosts in code (https://www.satopharma.com, https://satopharma.com). The endpoint
# never answers "*", so an origin that is not on the list simply receives no CORS headers.
RECRUITMENT_APPLY_ALLOWED_ORIGINS=


# ----- Recruitment: Inbound CV Intake — Email (optional) -----
# JSON array of IMAP mailbox credentials to poll for candidate CVs (app/api/cron/
# recruitment-email-intake). One entry per inbox, e.g.:
# [{"label":"careers","host":"imap.example.com","port":993,"secure":true,
#   "user":"careers@satopharma.com","password":"..."},
#  {"label":"hr","host":"imap.example.com","port":993,"secure":true,
#   "user":"hr@satopharma.com","password":"..."}]
RECRUITMENT_EMAIL_INBOXES_JSON=

# Optional override for the max accepted inbound CV attachment size, in bytes
# (default 15728640 = 15MB)
RECRUITMENT_INBOUND_CV_MAX_BYTES=

# ----- Recruitment: Inbound CV Intake — WhatsApp (optional, needs a provisioned Meta app) -----
# Meta App secret — verifies X-Hub-Signature-256 on inbound webhook payloads
WHATSAPP_APP_SECRET=

# Arbitrary string you choose and enter into Meta's webhook config; compared
# during the GET verification handshake (app/api/webhooks/whatsapp)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Permanent (System User) Graph API access token, used to download inbound CV media
WHATSAPP_ACCESS_TOKEN=

# Graph API version to call (optional, default v23.0)
WHATSAPP_GRAPH_API_VERSION=

# Optional — the configured WABA phone_number_id; a mismatch with the payload logs a
# warning only (the signature check above is the real authentication boundary)
WHATSAPP_PHONE_NUMBER_ID=

# ----- Recruitment: Interview Calendar — Zoom (optional) -----
# A Zoom Server-to-Server OAuth app, so Phoenix can create the meeting for a Zoom
# interview. Without all four, a Zoom booking still saves and says "not connected".
# The Zoom account the app was made in
ZOOM_ACCOUNT_ID=

# The app's client id and client secret
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email of the Zoom user who hosts every interview meeting
ZOOM_HOST_USER=


# ----- Dev-Only Flags (never set in production) -----
# Enable x-phoenix-role / x-phoenix-hr-id request headers for local role impersonation
# PHOENIX_ENABLE_DEV_AUTH_HEADERS=true

# Show beta employee portal navigation items
# PHOENIX_PORTAL_SHOW_BETA_NAV=true

# Mark Vercel preview deployments as read-only
# PHOENIX_PREVIEW_READ_ONLY=true

# Override editing mode for local development
# NEXT_PUBLIC_PHOENIX_EDITING_MODE=


# ----- Business Rules (optional overrides) -----
# Max excuse submissions per employee per month (default: 2)
PHOENIX_MONTHLY_EXCUSE_ALLOWANCE=2

# Cache TTL in seconds for the runtime permission matrix (default: 30)
PHOENIX_PERMISSION_MATRIX_CACHE_SECONDS=30


# ----- Playwright / E2E Tests (test environments only) -----
# HR ID and password for data-bearing E2E tests
# PLAYWRIGHT_DATA_USER_HRID=
# PLAYWRIGHT_DATA_USER_PASSWORD=


# ----- Synthetic User Journeys (pnpm run synthetic:test — see tests/synthetic/README.md) -----
# URL of the environment to smoke-test (e.g. http://localhost:3000). Required.
# SYNTHETIC_BASE_URL=
# Super Admin test account used to log in and run the journeys. Required.
# SYNTHETIC_ADMIN_HR_ID=
# SYNTHETIC_ADMIN_PASSWORD=
# Must be "true" to allow SYNTHETIC_BASE_URL to point at production. Leave unset otherwise.
# SYNTHETIC_ALLOW_PRODUCTION=
# Must be "true" to allow future mutating journeys to run. No current journey mutates data.
# SYNTHETIC_ALLOW_MUTATION=
# Bearer token required by POST /api/admin/synthetic-journeys/ingest (Authorization: Bearer <token>).
# SYNTHETIC_INGEST_TOKEN=


# ----- Script-Only Variables (used by npm/node scripts, not the app) -----
# Direct Postgres URL aliases used by export/migration scripts
# DATABASE_URL=
# POSTGRES_URL=

# Marketing reference data seeding
# MARKETING_PRODUCTS_XLSX=
# MARKETING_PHARMACY_DATABASE_XLSX=

# Employee portal launch smoke test
# PHOENIX_EMPLOYEE_PORTAL_BASE_URL=
# PHOENIX_EMPLOYEE_PORTAL_SMOKE_LOGIN_ID=
# PHOENIX_EMPLOYEE_PORTAL_SMOKE_PASSWORD=
# PHOENIX_EMPLOYEE_PORTAL_SMOKE_HR_ID=
# PHOENIX_EMPLOYEE_PORTAL_SMOKE_USERS_JSON=

# RLS staging test harness
# PHOENIX_STAGING_ENVIRONMENT=
# PHOENIX_STAGING_SUPABASE_URL=
# PHOENIX_STAGING_SUPABASE_ANON_KEY=
# PHOENIX_STAGING_DATABASE_URL=
# PHOENIX_LOCAL_SUPABASE_URL=
# PHOENIX_LOCAL_SUPABASE_ANON_KEY=
# PHOENIX_LOCAL_SUPABASE_DATABASE_URL=
# PHOENIX_RLS_FREE_ONLY=
# PHOENIX_RLS_ALLOW_PAID_BRANCH=
# PHOENIX_RLS_ALLOW_STAGING_MUTATIONS=
# PHOENIX_RLS_DRY_RUN=
# PHOENIX_RLS_AUTO_CREATE_TEST_USERS=
# PHOENIX_RLS_TEST_USERS_JSON=
# PHOENIX_CONFIRM_STAGING_RLS_RUN=

# Phase smoke test base URLs
# PHOENIX_PHASE23_BASE_URL=
# PHOENIX_PHASE26_BASE_URL=
# PHOENIX_PHASE27_PORT=

# Mailbox MCP — lets Claude Code itself read one company mailbox over read-only IMAP
# (scripts/mailbox-mcp.mjs). Local tooling only: the deployed app never reads these. It is
# deliberately NOT registered in .mcp.json, which every worktree gets: register it in the one
# folder that needs it with `claude mcp add mailbox -- node scripts/mailbox-mcp.mjs`.
# MAILBOX_MCP_PASSWORD is the mailbox's APP password — the one named `imap` in its own security
# settings — never the login password. Put the real values in .env.local, which is gitignored; the
# server reads the MAILBOX_MCP_ lines out of it and nothing else.
# MAILBOX_MCP_USER=
# MAILBOX_MCP_PASSWORD=
# MAILBOX_MCP_HOST=
# MAILBOX_MCP_PORT=
# MAILBOX_MCP_SECURE=
