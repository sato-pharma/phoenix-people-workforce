# 🔴 FOR THE OPTIONAL SELF-HOSTED BOX ONLY — NOT HOW THE COMPANY RUNS THIS TODAY. Since 2026-09-25
# Headwind runs on RAILWAY, where these values are Railway service variables set in its UI rather
# than a file (the list is in docs/devices/headwind-rustdesk.md §4.2), and the remote screen uses
# RustDesk's own free EU relay. Nothing below is needed for that.
#
# This file stays because one thing Railway cannot do is the RustDesk relay: it allows one TCP proxy
# port per service and no UDP, and the relay needs 21115–21119 TCP plus 21116 UDP. The day the
# company wants to own the relay, it wants a box, and this is that box's settings — copy to
# `.env.headwind` ON THAT BOX.
#
# 🔴 THIS FILE IS AN EXAMPLE AND HOLDS NO REAL VALUE. The real `.env.headwind` lives on the server
# only and is never committed, never pasted into a chat, and never copied onto a laptop.
#
#   docker compose --env-file .env.headwind -f docker-compose.headwind.yml up -d
#
# None of these are Phoenix's settings. What Phoenix itself needs (HEADWIND_MDM_*, RUSTDESK_*) goes
# on Railway and is listed in docs/environment.md.

# --- Image versions -----------------------------------------------------------------------------
# 🔴 PIN BOTH BEFORE THE FIRST RUN. Read the current published tag from Docker Hub
# (hub.docker.com/r/headwindmdm/hmdm and hub.docker.com/r/rustdesk/rustdesk-server) and write it
# here. `latest` on a server managing a hundred company tablets means an upgrade nobody chose can
# arrive with the next restart.
HEADWIND_IMAGE_TAG=
RUSTDESK_IMAGE_TAG=

# --- Headwind -----------------------------------------------------------------------------------
# The admin account created on the very first start, and the name the tablets will reach it at.
# 🔴 The domain must ALREADY point at this box: Headwind asks Let's Encrypt for a certificate on
# startup, and a name that does not resolve here fails that request and leaves the server without
# HTTPS.
# 🔴 BASE_DOMAIN IS THE TABLETS' NAME, AND IT IS A PLAIN A RECORD — Cloudflare's proxy OFF (grey
# cloud). The tablets check in on port 31000, which the proxy does not carry, so an orange cloud here
# takes the whole fleet offline. The CONSOLE gets its own hostname on the tunnel instead; see §4.6 of
# docs/devices/headwind-rustdesk.md.
ADMIN_EMAIL=
BASE_DOMAIN=mdm.satopharma.com

# Headwind's own database. Any long random password — it is used only between the two containers on
# this box and is never typed by a person.
SQL_BASE=hmdm
SQL_USER=hmdm
SQL_PASS=

# Leave EMPTY. Set it to 1 for exactly one restart if the very first configuration failed and has to
# run again; then empty it. On a working server it would re-run first-time setup.
FORCE_RECONFIGURE=
