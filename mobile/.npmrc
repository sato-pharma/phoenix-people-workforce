legacy-peer-deps=true

# Supply-chain cooling-off window for mobile/, which installs with npm and NOT pnpm (the `mobile`
# job in .github/workflows/ci.yml explains why: Metro walks node_modules directly and pnpm's
# symlinked store breaks that). Dependabot already waits 7 days before proposing a newly published
# version (.github/dependabot.yml, `cooldown: default-days: 7`) — but that governs Dependabot's own
# PRs, not what npm resolves here, so mobile/ was the one dependency path with no cooling-off at
# all. It is what the daily Semgrep scan has flagged since 2026-09-18
# (package_managers.npm.npm-missing-minimum-release-age); that job is schedule-only, so no PR ever
# surfaced it.
#
# 7 to match dependabot.yml rather than invent a second number. The unit is DAYS: npm's own config
# docs read "only versions that were available more than the given number of days ago will be
# installed". pnpm's `minimumReleaseAge` is MINUTES — the two values are not interchangeable.
#
# WHAT IT DOES AND DOES NOT TOUCH, measured on npm 11.12.1 and on the CI runner:
#   * npm flattens this into an internal `before` cutoff (`npm config list` prints the derived
#     `before = "<date>"` and `min-release-age` itself as null — that is normal, not a misread
#     file). npm refuses this setting together with an explicit `before`; nothing sets one.
#   * `npm ci` is UNAFFECTED — it installs the versions package-lock.json pins, even ones younger
#     than the window. expo-file-system@58.0.2 was 14 hours old when this was added and the
#     required `mobile` check still installed and typechecked clean.
#   * A fresh RESOLVE is what gets refused: asking npm for a version published inside the window
#     fails with `ETARGET  No matching version found ... with a date before <cutoff>`. That is the
#     point, but it will bite the next Expo SDK 58 preview bump taken within a week of its
#     publication. Either let the version age, or override the window for that ONE command with an
#     explicit `--min-release-age` flag on the command line — do not delete this line to get past
#     it.
#
# Do NOT write an example of that flag with a low value in this file, however clearly commented.
# The Semgrep rule matches the assignment token and does not care that it sits behind a `#`: the
# first version of this comment carried a zero-valued example and the scan simply moved its finding
# from line 1 to that comment line, reading it as a cooling-off window set too low.
min-release-age=7
