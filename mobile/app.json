{
  "expo": {
    "name": "Phoenix Workforce",
    "slug": "phoenix-workforce",
    "version": "0.1.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/phoenix/icon.png",
    "scheme": "phoenix",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f7f6f3",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/59942570-1f74-4f9c-8ff0-949f28d747cd",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "com.satopharma.phoenixworkforce",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0d1015",
        "foregroundImage": "./assets/phoenix/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.satopharma.phoenixworkforce",
      "supportsTablet": false
    },
    "plugins": [
      [
        "./plugins/with-onesignal-expo-plugin",
        {
          "mode": "production",
          "disableLocation": true,
          "smallIcons": ["./assets/phoenix/notification-icon.png"],
          "smallIconAccentColor": "#f97316"
        }
      ],
      "./plugins/with-onesignal-opens-the-app",
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1015",
          "dark": { "backgroundColor": "#0d1015" },
          "image": "./assets/phoenix/splash-mark.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Phoenix uses the camera for your profile photo and for evidence photos, such as the departure photo at the end of a trip.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Phoenix records where each evidence photo is taken, such as your departure photo at the end of a trip.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "59942570-1f74-4f9c-8ff0-949f28d747cd"
      }
    },
    "owner": "phoenix-sato-crm"
  }
}
