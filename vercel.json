{
  "crons": [
    {
      "path": "/api/notifications/daily",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/notifications/process?limit=50",
      "schedule": "*/30 * * * *"
    }
  ],
  "functions": {
    "app/api/sales/sales-upload/commit/route.ts": {
      "maxDuration": 300
    },
    "app/api/sales/**/*": {
      "maxDuration": 60
    }
  }
}
